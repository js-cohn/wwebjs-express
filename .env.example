# Server Configuration
# GHCR image to deploy with docker compose.
WWEBJS_IMAGE='ghcr.io/js-cohn/wwebjs-express:latest'
# For Caddy placeholders ({$...}) these values must be in Caddy's own process environment.
DOMAIN='wa.yourdomain.com'
PORT='3003'
# Number of trusted proxy hops in front of Express.
# Keep at 1 for the default "Caddy on host -> Docker-published app port" setup.
TRUST_PROXY_HOPS='1'

# Caddy upstream host:
# - localhost (default) when Caddy runs on the host
# - wwebjs-api when Caddy runs in Docker on the same Compose network
WWEBJS_UPSTREAM_HOST='localhost'
# Application Settings
WEBHOOK_URL='https://your-webhook-endpoint.com/receive'
# Whisper model for incoming audio/ptt transcription
WHISPER_MODEL='base'
# Max whisper.cpp runtime per audio in seconds
# base can take several minutes on small VMs
WHISPER_TIMEOUT_SECONDS='480'
# Maximum remote file download size for POST /send-file (in megabytes)
MAX_DOWNLOAD_MB='10'
# Remote file download timeout for POST /send-file (in seconds)
DOWNLOAD_TIMEOUT_SECONDS='15'
# Maximum number of validated HTTP redirects for POST /send-file
MAX_DOWNLOAD_REDIRECTS='5'

# Security Settings
# Caddy Basic Auth for /web-* endpoints.
BASIC_AUTH_USER='admin'
# Generate with:
#   caddy hash-password --plaintext 'your_password'
BASIC_AUTH_HASH='YOUR_CADDY_BCRYPT_HASH'
# Optional Express-level Basic Auth fallback for /web-* endpoints.
# Leave unset/empty to rely on Caddy only. If set, Express will require this
# plaintext password in addition to Caddy's Basic Auth layer.
BASIC_AUTH_PASS=''
# API key for /send-* endpoints. Enforced by both Caddy and Express.
# Recommended generator:
#   openssl rand -hex 32
API_KEY='YOUR_SECURE_API_KEY'
