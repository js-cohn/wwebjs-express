# Use directly (`caddy run --config ...`) or import from a parent Caddyfile.
# If imported, env placeholders below are still read from the Caddy service
# process environment (not from Docker Compose automatically).
#
# If placeholders are not resolving:
# 1) Add your env file to systemd:
#      run `sudo systemctl edit caddy` and add:
#      [Service]
#      EnvironmentFile=/absolute/path/to/wwebjs-express/.env
# 2) Reload/restart Caddy:
#      sudo systemctl daemon-reload && sudo systemctl restart caddy
# 3) Verify env file is loaded:
#      sudo systemctl show caddy -p EnvironmentFiles
#      pid=$(pgrep -x caddy | head -n1)
#      sudo sh -c "tr '\0' '\n' < /proc/$pid/environ | grep -E '^(DOMAIN|PORT|WWEBJS_UPSTREAM_HOST|BASIC_AUTH_USER|BASIC_AUTH_HASH|API_KEY)='"
(upstream) {
    reverse_proxy {$WWEBJS_UPSTREAM_HOST:localhost}:{$PORT:3003} {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
            read_timeout 30s
            write_timeout 30s
        }
    }
}

{$DOMAIN:localhost} {
    # Public access to media files.
    # Express handles this route and disables directory browsing natively.
    @files path /files/*
    handle @files {
        @files_bad_method {
            not method GET HEAD
        }
        respond @files_bad_method "Method Not Allowed" 405
        import upstream
    }

    # Shared /web-* rate limit (management endpoints)
    # Use {client_ip} so Cloudflare/user IP is used when trusted proxies are configured
    # in the parent/global Caddy config.
    @web path /web-*
    handle @web {
        @web_bad_method {
            not method GET
        }
        respond @web_bad_method "Method Not Allowed" 405

        rate_limit {
            zone web_auth_limit {
                key {client_ip}
                events 50
                window 5m
            }
        }

        basic_auth {
            {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
        }
        import upstream
    }

    # POSTs: 1000 attempts per minute
    @send path /send-*
    handle @send {
        @send_bad_method {
            not method POST
        }
        respond @send_bad_method "Method Not Allowed" 405

        request_body {
            max_size 64KB
        }

        rate_limit {
            zone api_send_limit {
                key {client_ip}
                events 1000
                window 1m
            }
        }

        @unauthorized {
            not header X-API-Key "{$API_KEY}"
        }
        respond @unauthorized "Unauthorized" 401

        import upstream
    }

    handle {
        respond "Not Found" 404
    }
}
